# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
FRONTEND_URL=https://dogeland.vn
APP_URL=https://api.dogeland.vn

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dogeland:CHANGE_ME@localhost:5432/dogeland
DB_NAME=dogeland
DB_USER=dogeland
DB_PASSWORD=CHANGE_ME

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Dogeland <noreply@dogeland.vn>

# ─── Discord OAuth ────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME

# ─── Minecraft ────────────────────────────────────────────────────────────────
MC_SERVER_HOST=play.dogeland.vn

# ─── SSL / Traefik ────────────────────────────────────────────────────────────
ACME_EMAIL=admin@dogeland.vn

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.dogeland.vn/api/v1
NEXT_PUBLIC_APP_URL=https://dogeland.vn
