# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL="postgresql://dogeland:dogeland_dev_password@localhost:5432/dogeland?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dogeland_redis_dev

# AuthMe MySQL
AUTHME_DATABASE_URL="mysql://authme:authme_dev_password@localhost:3306/authme"

# JWT
JWT_SECRET=change_me_in_production_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CSRF
CSRF_SECRET=change_me_in_production_csrf_secret_min_32_chars

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Dogeland <noreply@dogeland.vn>"

# Momo Payment
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:3000/dashboard/deposit/callback
MOMO_IPN_URL=http://localhost:4000/api/v1/payments/momo/webhook

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
